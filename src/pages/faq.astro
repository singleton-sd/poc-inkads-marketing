---
import { getCollection, getEntry } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqItem from "../components/FaqItem.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/nav";
import { requirePageData } from "../lib/require-page-data";

const page = requirePageData(await getEntry("pages", "faq"), "faq");

const faqs = (await getCollection("faqs"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL;
const eyebrow = page.eyebrow ?? "FAQ";
const ctaTitle = page.ctaTitle ?? "Still have a question?";
const ctaLabel = page.ctaLabel ?? "Contact us";
const ctaHref = page.ctaHref ?? "/contact";
---

<BaseLayout title={page.title} description={page.description}>
  <main id="main-content">
    <PageHero eyebrow={eyebrow} title={page.headline}>
      <ul class="faq-list" role="list">
        {
          faqs.map((item) => (
            <FaqItem
              question={item.data.question}
              answer={item.data.answer}
              link={item.data.link}
            />
          ))
        }
      </ul>
    </PageHero>

    <CtaBand title={ctaTitle} tone="brand" titleId="faq-cta-title">
      <ButtonLink
        href={withBase(ctaHref, base)}
        label={ctaLabel}
        variant="inverse"
      />
    </CtaBand>
  </main>
</BaseLayout>
