---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/legal.css";

const page = await getEntry("legal", "privacy");
if (!page) {
  throw new Error(
    "The privacy legal entry is missing. Add src/content/legal/privacy.md.",
  );
}
if (page.data.draft) {
  throw new Error(
    "The privacy page is marked draft. Set draft: false before publishing.",
  );
}

const { Content } = await render(page);
const effectiveDate = page.data.effectiveDate.toLocaleDateString("en-GB", {
  dateStyle: "long",
});
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <main id="main-content">
    <section class="shell legal-section" aria-labelledby="privacy-title">
      <h1 id="privacy-title">{page.data.title}</h1>
      <p class="legal-effective">Effective {effectiveDate}</p>
      <div class="page-copy">
        <Content />
      </div>
    </section>
  </main>
</BaseLayout>
