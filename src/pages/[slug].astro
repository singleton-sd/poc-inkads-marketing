---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/nav";
import {
  isReservedPageSlug,
  isValidMarketingSlug,
} from "../lib/reserved-slugs";
import "../styles/pages/marketing.css";

export async function getStaticPaths() {
  const entries = await getCollection("marketing", ({ data }) => !data.draft);
  const paths = [];

  for (const entry of entries) {
    const slug = entry.id;
    if (isReservedPageSlug(slug)) {
      throw new Error(
        `Marketing page slug "${slug}" conflicts with a fixed site route. Rename or remove src/content/marketing/${slug}.md.`,
      );
    }
    if (!isValidMarketingSlug(slug)) {
      throw new Error(
        `Marketing page slug "${slug}" is invalid. Use lowercase letters, numbers, and hyphens only.`,
      );
    }
    paths.push({ params: { slug }, props: { entry } });
  }

  return paths;
}

interface Props {
  entry: CollectionEntry<"marketing">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, eyebrow, headline, summary, ctaLabel, ctaHref } =
  entry.data;
const base = import.meta.env.BASE_URL;
const hasCta = Boolean(ctaLabel && ctaHref);
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <PageHero eyebrow={eyebrow ?? "InkAds"} title={headline} lead={summary} />

    <section class="shell marketing-section" aria-label="Page content">
      <div class="page-copy">
        <Content />
      </div>
    </section>

    {
      hasCta && (
        <CtaBand title={headline} tone="brand">
          <ButtonLink
            href={withBase(ctaHref!, base)}
            label={ctaLabel!}
            variant="inverse"
          />
        </CtaBand>
      )
    }
  </main>
</BaseLayout>
