---
import { getCollection, render, type CollectionEntry } from "astro:content";
import AudienceLandingLayout from "../components/marketing/AudienceLandingLayout.astro";
import CtaHeavyLayout from "../components/marketing/CtaHeavyLayout.astro";
import LandingBandLayout from "../components/marketing/LandingBandLayout.astro";
import ProseLayout from "../components/marketing/ProseLayout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  isReservedPageSlug,
  isValidMarketingSlug,
} from "../lib/reserved-slugs";
import "../styles/pages/marketing.css";

export async function getStaticPaths() {
  const entries = await getCollection("marketing", ({ data }) => !data.draft);
  const paths = [];

  for (const entry of entries) {
    const slug = entry.id;
    if (isReservedPageSlug(slug)) {
      throw new Error(
        `Marketing page slug "${slug}" conflicts with a fixed site route. Rename or remove src/content/marketing/${slug}.md.`,
      );
    }
    if (!isValidMarketingSlug(slug)) {
      throw new Error(
        `Marketing page slug "${slug}" is invalid. Use lowercase letters, numbers, and hyphens only.`,
      );
    }
    paths.push({ params: { slug }, props: { entry } });
  }

  return paths;
}

interface Props {
  entry: CollectionEntry<"marketing">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, template } = entry.data;
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    {
      template === "prose" ? (
        <ProseLayout entry={entry}>
          <Content />
        </ProseLayout>
      ) : template === "cta-heavy" ? (
        <CtaHeavyLayout entry={entry}>
          <Content />
        </CtaHeavyLayout>
      ) : template === "landing-band" ? (
        <LandingBandLayout entry={entry} />
      ) : (
        <AudienceLandingLayout entry={entry} />
      )
    }
  </main>
</BaseLayout>
