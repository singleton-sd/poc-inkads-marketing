---
import { getEntry } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import CtaBand from "../components/CtaBand.astro";
import EditorialCard from "../components/EditorialCard.astro";
import EpaperPreview from "../components/EpaperPreview.astro";
import InverseSection from "../components/InverseSection.astro";
import PageHero from "../components/PageHero.astro";
import PlaceCard from "../components/PlaceCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SystemList from "../components/SystemList.astro";
import SystemStep from "../components/SystemStep.astro";
import TextLink from "../components/TextLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/nav";

const home = await getEntry("pages", "home");
if (!home) throw new Error("The home page content entry is missing.");
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <main id="main-content">
    <PageHero
      eyebrow="E-paper · shared spaces"
      title={home.data.headline}
      lead={home.data.summary}
      split
    >
      <ButtonLink
        slot="actions"
        href={withBase("/contact", base)}
        label="Request a demo"
      />
      <ButtonLink
        slot="actions"
        href={withBase("/how-it-works", base)}
        label="See how it works"
        variant="secondary"
      />
      <EpaperPreview />
    </PageHero>

    <InverseSection centered labelledBy="statement-title">
      <SectionHeading
        eyebrow="The idea"
        title="A calmer format for useful messages in physical places."
        lead="InkAds connects venue space with advertiser messages through low-power e-paper displays — a considered alternative to adding another bright, animated screen. No mains power required at each unit, and content changes remotely on a schedule."
        tone="light"
        align="center"
        titleId="statement-title"
      />
    </InverseSection>

    <section
      id="audiences"
      class="shell audience-section"
      aria-labelledby="audiences-title"
    >
      <SectionHeading
        eyebrow="Two paths · one network"
        title="Designed around the space and the message."
        titleId="audiences-title"
      />
      <div class="card-grid">
        <EditorialCard
          id="venues"
          eyebrow="01 / Venues"
          title="Give overlooked space a useful role"
          description="A display format designed to fit the character and practical needs of your venue — no cabling, no bright video screen."
        >
          <TextLink
            href={withBase("/venues", base)}
            label="See the venue model"
          />
        </EditorialCard>
        <EditorialCard
          id="advertisers"
          eyebrow="02 / Advertisers"
          title="Place messages in relevant contexts"
          description="A tactile canvas for context-aware creative, with scheduled changes and QR calls to action — no printing, no replacing posters."
          accent="audience"
        >
          <TextLink
            href={withBase("/advertisers", base)}
            label="Explore placement contexts"
            accent="audience"
          />
        </EditorialCard>
      </div>
    </section>

    <section
      id="how-it-works"
      class="system-section"
      aria-labelledby="system-title"
    >
      <div class="shell">
        <SectionHeading
          eyebrow="A simple system"
          title="From message to place."
          titleId="system-title"
        />
        <SystemList layout="columns">
          <SystemStep
            number="01"
            title="Match"
            description="A venue and message are considered together, with context guiding placement."
          />
          <SystemStep
            number="02"
            title="Prepare"
            description="Creative is composed for a static e-paper canvas rather than a conventional digital screen."
          />
          <SystemStep
            number="03"
            title="Display"
            description="The device presents the selected message within the venue's shared space."
          />
        </SystemList>
      </div>
    </section>

    <section id="places" class="places-section" aria-labelledby="places-title">
      <div class="shell">
        <SectionHeading
          eyebrow="Use cases · built to adapt"
          title="Start specific. Think beyond one setting."
          lead="Bathrooms are the initial proof-of-concept context, not the limit of the idea. The same format could work anywhere a calm, considered display belongs."
          titleId="places-title"
        />
        <div class="places-grid">
          <PlaceCard
            index="01"
            title="Bathrooms"
            description="Testing how a compact display fits a private, high-dwell shared space."
            featured
          />
          <PlaceCard
            index="02"
            title="Pubs & hospitality"
            description="Placements where people gather, pause, and make local decisions."
          />
          <PlaceCard
            index="03"
            title="Shopping centres"
            description="A format to explore across varied retail environments and amenities."
          />
          <PlaceCard
            index="04"
            title="High-traffic spaces"
            description="Other settings where a static message can complement the environment."
          />
        </div>
        <p class="section-follow-link">
          <TextLink
            href={withBase("/places", base)}
            label="See all use cases"
          />
        </p>
      </div>
    </section>

    <CtaBand
      eyebrow="Choose a perspective"
      title="A shared canvas needs both sides."
      tone="brand"
      titleId="closing-title"
    >
      <ButtonLink
        href={withBase("/venues", base)}
        label="Venue perspective"
        variant="inverse"
      />
      <ButtonLink
        href={withBase("/advertisers", base)}
        label="Advertiser perspective"
        variant="ghost-inverse"
      />
    </CtaBand>
  </main>
</BaseLayout>
