---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const home = await getEntry("pages", "home");
if (!home) throw new Error("The home page content entry is missing.");
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <main class="mx-auto flex min-h-[70vh] max-w-6xl items-center px-6 py-24">
    <section class="max-w-3xl" aria-labelledby="page-title">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--ink-accent)]"
      >
        InkAds
      </p>
      <h1
        id="page-title"
        class="text-5xl font-semibold tracking-tight sm:text-7xl"
      >
        {home.data.headline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--ink-text-muted)]">
        {home.data.summary}
      </p>
    </section>
  </main>
</BaseLayout>
