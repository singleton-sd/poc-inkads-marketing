---
import { getEntry } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import CtaBand from "../components/CtaBand.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import FeatureItem from "../components/FeatureItem.astro";
import InverseSection from "../components/InverseSection.astro";
import MediaPlaceholder from "../components/MediaPlaceholder.astro";
import PageHero from "../components/PageHero.astro";
import ProcessRow from "../components/ProcessRow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/nav";

const venues = await getEntry("pages", "venues");
if (!venues || venues.data.template !== "venues") {
  throw new Error("The venues page content entry is missing.");
}

const {
  title,
  description,
  headline,
  summary,
  eyebrow,
  ctaLabel,
  ctaHref,
  mediaLabel,
  benefitsEyebrow,
  benefits,
  processEyebrow,
  processHeadline,
  process,
  closingHeadline,
} = venues.data;

const base = import.meta.env.BASE_URL;
const contactHref = withBase(ctaHref, base);
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <PageHero eyebrow={eyebrow} title={headline} lead={summary} split>
      <ButtonLink slot="actions" href={contactHref} label={ctaLabel} />
      <MediaPlaceholder label={mediaLabel} minHeight="340px" />
    </PageHero>

    <InverseSection labelledBy="benefits-title">
      <p class="eyebrow" id="benefits-title">{benefitsEyebrow}</p>
      <FeatureGrid>
        {
          benefits.map((benefit) => (
            <FeatureItem
              title={benefit.title}
              description={benefit.description}
            />
          ))
        }
      </FeatureGrid>
    </InverseSection>

    <section class="shell band" aria-labelledby="process-title">
      <SectionHeading
        eyebrow={processEyebrow}
        title={processHeadline}
        titleId="process-title"
      />
      <ul class="process-list">
        {
          process.map((step) => (
            <ProcessRow label={step.label} detail={step.detail} />
          ))
        }
      </ul>
    </section>

    <CtaBand title={closingHeadline} tone="brand" titleId="venues-cta-title">
      <ButtonLink href={contactHref} label={ctaLabel} variant="inverse" />
    </CtaBand>
  </main>
</BaseLayout>
