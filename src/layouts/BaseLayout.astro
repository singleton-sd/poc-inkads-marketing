---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/500.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { brandIconUrl } from "../lib/brand-assets";

interface Props {
  title: string;
  description: string;
  /** Override default index,follow (e.g. noindex for 404). */
  robots?: string;
  ogType?: string;
}

const {
  title,
  description,
  robots = "index,follow",
  ogType = "website",
} = Astro.props;

const base = import.meta.env.BASE_URL || "/";
const currentPath = Astro.url.pathname;
const siteRoot = Astro.site
  ? String(Astro.site)
  : "https://inkads.poc.singletonsd.com";

/** Absolute URL for a public asset, honouring BASE_URL / preview base. */
function absoluteAsset(assetPath: string): string {
  const trimmed = assetPath.replace(/^\//, "");
  return new URL(trimmed, new URL(base, siteRoot)).href;
}

const canonicalUrl = new URL(Astro.url.pathname, siteRoot).toString();
const ogImageUrl = absoluteAsset("og-image.png");
const logoUrl = brandIconUrl("dark");
const websiteId = `${new URL(base, siteRoot).href.replace(/\/?$/, "/")}#website`;
const organizationId = `${new URL(base, siteRoot).href.replace(/\/?$/, "/")}#organization`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "InkAds",
      url: new URL(base, siteRoot).href,
      logo: logoUrl,
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: new URL(base, siteRoot).href,
      name: "InkAds",
      description:
        "E-paper advertising for shared spaces — pubs, centres, waiting areas, and more.",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffb300" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${base}favicon-32.png`}
    />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="InkAds" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="InkAds — e-paper advertising for shared spaces"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta
      name="twitter:image:alt"
      content="InkAds — e-paper advertising for shared spaces"
    />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={currentPath} />
    <slot />
    <SiteFooter />
  </body>
</html>
