---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email";
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  required = false,
  placeholder,
  autocomplete,
} = Astro.props;
---

<div class="field">
  <label class="field__label" for={id}>{label}</label>
  <input
    class="field-control"
    id={id}
    name={name}
    type={type}
    required={required}
    placeholder={placeholder}
    autocomplete={autocomplete}
  />
</div>
