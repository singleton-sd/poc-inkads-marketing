---
import ContactFormIsland from "./ContactFormIsland";
import {
  parseEmailFromQuery,
  parseNameFromQuery,
  resolveRoleOption,
} from "../lib/form-query-sync";
import { withBase } from "../lib/nav";

interface Props {
  successTitle?: string;
  successBody?: string;
  submitLabel?: string;
}

const {
  successTitle = "Message sent.",
  successBody = "Thank you. We will follow up by email if your enquiry needs a response.",
  submitLabel = "Send message",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const privacyHref = withBase("/privacy", base);
const postkitApiBaseUrl = import.meta.env.PUBLIC_POSTKIT_API_BASE_URL as
  string | undefined;

const params = Astro.url.searchParams;
const initialRole = resolveRoleOption(params.get("role")) ?? "";
const initialName = parseNameFromQuery(params.get("name"));
const initialEmail = parseEmailFromQuery(params.get("email"));
---

<ContactFormIsland
  client:load
  successTitle={successTitle}
  successBody={successBody}
  submitLabel={submitLabel}
  privacyHref={privacyHref}
  postkitApiBaseUrl={postkitApiBaseUrl}
  initialRole={initialRole}
  initialName={initialName}
  initialEmail={initialEmail}
/>
