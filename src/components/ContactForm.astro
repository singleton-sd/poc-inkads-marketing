---
import Select from "./Select.astro";
import Textarea from "./Textarea.astro";
import TextInput from "./TextInput.astro";
import TextLink from "./TextLink.astro";
import { withBase } from "../lib/nav";

interface Props {
  successTitle?: string;
  successBody?: string;
  submitLabel?: string;
}

const {
  successTitle = "Message sent.",
  successBody = "Thank you. We will follow up by email if your enquiry needs a response.",
  submitLabel = "Send message",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const privacyHref = withBase("/privacy", base);

const roleOptions = ["Venue owner / operator", "Advertiser / brand", "Other"];
---

<div class="contact-form-shell" data-contact-form>
  <form class="contact-form" data-contact-form-fields novalidate>
    <div class="contact-form__row">
      <TextInput
        id="contact-name"
        name="name"
        label="Name"
        required
        autocomplete="name"
      />
      <TextInput
        id="contact-company"
        name="company"
        label="Venue / company"
        required
        autocomplete="organization"
      />
    </div>
    <TextInput
      id="contact-email"
      name="email"
      label="Email"
      type="email"
      required
      autocomplete="email"
    />
    <Select
      id="contact-role"
      name="role"
      label="I am a…"
      options={roleOptions}
      required
    />
    <Textarea
      id="contact-message"
      name="message"
      label="Tell us about your space or campaign"
      required
    />
    <p class="contact-form__privacy">
      See our <TextLink href={privacyHref} label="Privacy Policy" /> for how we handle
      contact submissions.
    </p>
    <p class="contact-form__error" hidden role="alert" data-contact-form-error>
    </p>
    <button
      class="button-link button-link--primary button-link--block"
      type="submit"
      data-contact-form-submit
    >
      {submitLabel}
    </button>
  </form>
  <div
    class="contact-form__success"
    hidden
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-contact-form-success
  >
    <h2>{successTitle}</h2>
    <p>{successBody}</p>
  </div>
</div>

<script>
  const ROLE_TO_SUBJECT: Record<string, string> = {
    "Venue owner / operator": "partnership",
    "Advertiser / brand": "sales",
    Other: "general",
  };

  /** Query `role` aliases → select option labels (same mapping as submit subjects). */
  const ROLE_QUERY_TO_OPTION: Record<string, string> = {
    venue: "Venue owner / operator",
    partnership: "Venue owner / operator",
    advertiser: "Advertiser / brand",
    sales: "Advertiser / brand",
    other: "Other",
    general: "Other",
  };

  /** Option labels → short query aliases written back to the URL. */
  const ROLE_OPTION_TO_QUERY: Record<string, string> = {
    "Venue owner / operator": "venue",
    "Advertiser / brand": "advertiser",
    Other: "other",
  };

  const ROLE_OPTION_VALUES = new Set(Object.values(ROLE_QUERY_TO_OPTION));
  const SAFE_NAME_MAX = 200;
  const SAFE_EMAIL_MAX = 254;
  // Reject whitespace, @, and C0/DEL controls in each segment (blocks %00 etc.).
  const SAFE_EMAIL_RE =
    /^[^\s@\u0000-\u001f\u007f]+@[^\s@\u0000-\u001f\u007f]+\.[^\s@\u0000-\u001f\u007f]+$/;

  function resolveRoleOption(raw: string | null): string | null {
    if (raw == null) return null;
    const trimmed = raw.trim();
    if (!trimmed) return null;
    const byAlias = ROLE_QUERY_TO_OPTION[trimmed.toLowerCase()];
    if (byAlias) return byAlias;
    if (ROLE_OPTION_VALUES.has(trimmed)) return trimmed;
    return null;
  }

  function applyContactQueryPrefills(form: HTMLFormElement) {
    const params = new URLSearchParams(window.location.search);

    const roleOption = resolveRoleOption(params.get("role"));
    if (roleOption) {
      const roleSelect = form.elements.namedItem(
        "role",
      ) as HTMLSelectElement | null;
      if (roleSelect) roleSelect.value = roleOption;
    }

    const nameRaw = params.get("name")?.trim() ?? "";
    if (
      nameRaw.length > 0 &&
      nameRaw.length <= SAFE_NAME_MAX &&
      !/[\u0000-\u001f\u007f]/.test(nameRaw)
    ) {
      const nameInput = form.elements.namedItem(
        "name",
      ) as HTMLInputElement | null;
      if (nameInput) nameInput.value = nameRaw;
    }

    const emailRaw = params.get("email")?.trim() ?? "";
    if (
      emailRaw.length > 0 &&
      emailRaw.length <= SAFE_EMAIL_MAX &&
      SAFE_EMAIL_RE.test(emailRaw)
    ) {
      const emailInput = form.elements.namedItem(
        "email",
      ) as HTMLInputElement | null;
      if (emailInput) emailInput.value = emailRaw;
    }
  }

  /** Keep the address bar in sync when the role select changes (replaceState). */
  function syncRoleQueryParam(form: HTMLFormElement) {
    const roleSelect = form.elements.namedItem(
      "role",
    ) as HTMLSelectElement | null;
    if (!roleSelect) return;

    const url = new URL(window.location.href);
    const alias = ROLE_OPTION_TO_QUERY[roleSelect.value];
    if (alias) url.searchParams.set("role", alias);
    else url.searchParams.delete("role");

    const next = `${url.pathname}${url.search}${url.hash}`;
    const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (next !== current) {
      history.replaceState(history.state, "", next);
    }
  }

  function setupContactForm() {
    const root = document.querySelector<HTMLElement>("[data-contact-form]");
    if (!root) return;

    const form = root.querySelector<HTMLFormElement>(
      "[data-contact-form-fields]",
    );
    // Always re-apply prefills (full load + client navigations).
    if (form) applyContactQueryPrefills(form);

    // Guard listeners: astro:page-load may fire when ClientRouter is present.
    if (root.dataset.contactFormReady === "true") return;
    root.dataset.contactFormReady = "true";

    const success = root.querySelector<HTMLElement>(
      "[data-contact-form-success]",
    );
    const error = root.querySelector<HTMLElement>("[data-contact-form-error]");
    const submitButton = root.querySelector<HTMLButtonElement>(
      "[data-contact-form-submit]",
    );
    if (!form || !success || !error || !submitButton) return;

    const roleSelect = form.elements.namedItem(
      "role",
    ) as HTMLSelectElement | null;
    roleSelect?.addEventListener("change", () => syncRoleQueryParam(form));

    const apiBase = (
      import.meta.env.PUBLIC_POSTKIT_API_BASE_URL as string | undefined
    )?.replace(/\/$/, "");
    if (!apiBase || !apiBase.startsWith("https://")) {
      error.hidden = false;
      error.textContent =
        "Contact delivery is not configured. Email hello@inkads.poc.singletonsd.com instead.";
      submitButton.disabled = true;
      return;
    }

    const FETCH_TIMEOUT_MS = 15_000;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;
      error.textContent = "";

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const nameInput = form.elements.namedItem("name") as HTMLInputElement;
      const companyInput = form.elements.namedItem(
        "company",
      ) as HTMLInputElement;
      const emailInput = form.elements.namedItem("email") as HTMLInputElement;
      const roleSelect = form.elements.namedItem("role") as HTMLSelectElement;
      const messageInput = form.elements.namedItem(
        "message",
      ) as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const company = companyInput.value.trim();
      const email = emailInput.value.trim();
      const role = roleSelect.value.trim();
      const messageBody = messageInput.value.trim();

      const trimmedRequired: Array<{
        el: HTMLInputElement | HTMLTextAreaElement;
        value: string;
        label: string;
      }> = [
        { el: nameInput, value: name, label: "Name" },
        { el: companyInput, value: company, label: "Venue / company" },
        { el: messageInput, value: messageBody, label: "Message" },
      ];
      for (const field of trimmedRequired) {
        if (field.value.length === 0) {
          field.el.setCustomValidity(`${field.label} is required.`);
          field.el.reportValidity();
          field.el.setCustomValidity("");
          return;
        }
        field.el.setCustomValidity("");
      }

      const subject = ROLE_TO_SUBJECT[role] ?? "general";
      const message = `Venue / company: ${company}\n\n${messageBody}`;
      const isPreview = location.pathname.includes("/pr-preview/");

      submitButton.disabled = true;
      const controller = new AbortController();
      const timeoutId = window.setTimeout(
        () => controller.abort(),
        FETCH_TIMEOUT_MS,
      );
      try {
        const response = await fetch(`${apiBase}/contact`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
            ...(isPreview ? { "X-PostKit-Contact-Preview": "true" } : {}),
          },
          credentials: "omit",
          signal: controller.signal,
          body: JSON.stringify({ name, email, subject, message }),
        });

        if (!response.ok) {
          if (response.status === 400) {
            error.textContent =
              "Please check the highlighted fields and try again.";
          } else if (response.status === 429) {
            error.textContent =
              "Too many messages were sent. Please wait a minute and try again.";
          } else if (response.status >= 500) {
            error.textContent =
              "Delivery is temporarily unavailable. Please try again later.";
          } else {
            error.textContent =
              "We could not send your message. Please try again shortly.";
          }
          error.hidden = false;
          return;
        }

        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (err) {
        const timedOut =
          err instanceof DOMException && err.name === "AbortError";
        error.textContent = timedOut
          ? "Delivery is temporarily unavailable. Please try again later."
          : "We could not reach the server. Check your connection and try again.";
        error.hidden = false;
      } finally {
        window.clearTimeout(timeoutId);
        submitButton.disabled = false;
      }
    });
  }

  // Run on full page load (this site has no ClientRouter). Also listen for
  // astro:page-load if View Transitions are added later.
  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
