---
interface Props {
  defaultTab?: "poster" | "advertiser" | "yours";
}

const { defaultTab = "poster" } = Astro.props;

const captions = {
  poster: "Venue poster artwork · as the 1-bit panel renders it",
  advertiser: "Advertiser creative · matched by venue context",
  yours: "Your artwork · rendered by the shared e-paper pipeline",
} as const;
---

<div class="epaper-preview" data-epaper-preview data-active={defaultTab}>
  <figure class="epaper-preview__device">
    <div class="epaper-preview__chrome">
      <p>Preview on display</p>
      <div
        class="epaper-preview__tabs"
        role="tablist"
        aria-label="Preview mode"
      >
        <button
          class="epaper-preview__tab"
          type="button"
          role="tab"
          aria-selected={defaultTab === "poster" ? "true" : "false"}
          data-epaper-tab="poster">Poster</button
        >
        <button
          class="epaper-preview__tab"
          type="button"
          role="tab"
          aria-selected={defaultTab === "advertiser" ? "true" : "false"}
          data-epaper-tab="advertiser">Advertiser</button
        >
        <button
          class="epaper-preview__tab"
          type="button"
          role="tab"
          aria-selected={defaultTab === "yours" ? "true" : "false"}
          data-epaper-tab="yours">Yours</button
        >
      </div>
    </div>
    <div class="epaper-preview__screen">
      <div
        class:list={[
          "epaper-preview__panel",
          defaultTab === "poster" && "is-active",
        ]}
        data-epaper-panel="poster"
      >
        <div class="epaper-preview__poster">
          <p class="epaper-preview__poster-mark">College Lawn · Trivia night</p>
          <div>
            <h3>Tuesday trivia. Same booth. New questions.</h3>
          </div>
          <div class="epaper-preview__bar">
            <span>InkAds</span>
            <span>Updated 06:00</span>
          </div>
        </div>
      </div>
      <div
        class:list={[
          "epaper-preview__panel",
          defaultTab === "advertiser" && "is-active",
        ]}
        data-epaper-panel="advertiser"
      >
        <div class="epaper-preview__advertiser">
          <p class="epaper-preview__poster-mark">
            Northbank Coffee Roasters · Campaign 04
          </p>
          <div>
            <h3>Two streets away. Still warm.</h3>
            <p>
              Single-origin filter, roasted this week. Show this screen for 20%
              off your first cup.
            </p>
          </div>
          <div class="epaper-preview__bar">
            <span>Claim the offer</span>
            <span>Scan for voucher</span>
          </div>
        </div>
      </div>
      <div
        class:list={[
          "epaper-preview__panel",
          defaultTab === "yours" && "is-active",
        ]}
        data-epaper-panel="yours"
      >
        <div
          class="epaper-preview__drop"
          data-epaper-drop
          role="button"
          tabindex="0"
          aria-label="Drop PNG or JPEG artwork, or press to upload"
        >
          <span data-epaper-drop-label
            >Drop PNG or JPEG · 800 × 480 Waveshare B/W</span
          >
          <img alt="" hidden data-epaper-preview-image />
          <input
            type="file"
            accept="image/png,image/jpeg"
            hidden
            data-epaper-file
          />
        </div>
      </div>
    </div>
  </figure>
  <div class="epaper-preview__meta">
    <p data-epaper-caption>{captions[defaultTab]}</p>
    <p data-epaper-size>800 × 480 · 1-bit e-paper</p>
  </div>
  <div class="epaper-preview__controls" data-epaper-controls hidden>
    <label>
      Render mode
      <select data-epaper-mode>
        <option value="atkinson" selected>Atkinson</option>
        <option value="threshold">Threshold</option>
        <option value="floyd-steinberg">Floyd–Steinberg</option>
      </select>
    </label>
    <div class="epaper-preview__orient" role="group" aria-label="Orientation">
      <button
        type="button"
        class="epaper-preview__orient-btn"
        data-epaper-rotate-image
      >
        Rotate image
      </button>
      <div class="epaper-preview__mount" role="group" aria-label="Screen mount">
        <button
          type="button"
          class="epaper-preview__orient-btn is-active"
          data-epaper-mount="landscape"
          aria-pressed="true"
        >
          Landscape
        </button>
        <button
          type="button"
          class="epaper-preview__orient-btn"
          data-epaper-mount="portrait"
          aria-pressed="false"
        >
          Portrait
        </button>
      </div>
    </div>
    <div class="epaper-preview__pan" role="group" aria-label="Pan framing">
      <span class="epaper-preview__pan-label">Pan</span>
      <div class="epaper-preview__pan-grid">
        <button
          type="button"
          class="epaper-preview__pan-btn"
          data-epaper-pan="n"
          aria-label="Move image up">↑</button
        >
        <button
          type="button"
          class="epaper-preview__pan-btn"
          data-epaper-pan="w"
          aria-label="Move image left">←</button
        >
        <button
          type="button"
          class="epaper-preview__pan-btn"
          data-epaper-pan="reset"
          aria-label="Reset framing to cover fit">Reset</button
        >
        <button
          type="button"
          class="epaper-preview__pan-btn"
          data-epaper-pan="e"
          aria-label="Move image right">→</button
        >
        <button
          type="button"
          class="epaper-preview__pan-btn"
          data-epaper-pan="s"
          aria-label="Move image down">↓</button
        >
      </div>
      <p class="epaper-preview__hint">Drag to move · scroll or pinch to zoom</p>
    </div>
  </div>
  <p
    class="epaper-preview__status"
    data-epaper-status
    role="status"
    aria-live="polite"
  >
  </p>
  <div class="epaper-preview__upload">
    <p>
      <strong>Try your own creative</strong>
      Colour and greyscale become 1-bit on the panel. This is a browser simulation
      using the same renderer as the device pipeline — not a live display.
    </p>
    <button
      class="button-link button-link--secondary"
      type="button"
      data-epaper-upload
    >
      Upload artwork
    </button>
  </div>
</div>

<script>
  import {
    clampFraming,
    defaultFraming,
    framingNudgeFromPointerDrag,
    framingPanRoom,
    nextSourceRotation,
    panFraming,
    panelSizeLabel,
    readImageSize,
    renderUploadPreview,
    rotatedImageSize,
    sourceRectFromFraming,
    type FramingState,
    type ImageSize,
    type PanDirection,
    type ScreenMount,
    type SourceRotation,
  } from "../lib/epaper-preview.ts";
  import {
    waveshare75BwProfile,
    type MonoRenderMode,
  } from "@singleton-sd/inkads-epaper-renderer";

  const captions = {
    poster: "Venue poster artwork · as the 1-bit panel renders it",
    advertiser: "Advertiser creative · matched by venue context",
    yours: "Your artwork · rendered by the shared e-paper pipeline",
  };

  /** Cover-fit framing uses the logical landscape panel size. */
  const framingProfile = waveshare75BwProfile;
  const MIN_ZOOM = 0.25;
  const MAX_ZOOM = 8;
  const PAN_STEP = 0.25;
  const DEBOUNCE_MS = 80;
  const PAN_ROOM_EPS = 1e-6;

  function activateTab(root: HTMLElement, tab: string) {
    root.dataset.active = tab;
    root
      .querySelectorAll<HTMLButtonElement>("[data-epaper-tab]")
      .forEach((button) => {
        button.setAttribute(
          "aria-selected",
          button.dataset.epaperTab === tab ? "true" : "false",
        );
      });
    root
      .querySelectorAll<HTMLElement>("[data-epaper-panel]")
      .forEach((panel) => {
        panel.classList.toggle("is-active", panel.dataset.epaperPanel === tab);
      });
    const caption = root.querySelector<HTMLElement>("[data-epaper-caption]");
    if (caption && tab in captions) {
      caption.textContent = captions[tab as keyof typeof captions];
    }
  }

  function clampZoom(zoom: number): number {
    return Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, zoom));
  }

  function touchDistance(a: Touch, b: Touch): number {
    const dx = a.clientX - b.clientX;
    const dy = a.clientY - b.clientY;
    return Math.hypot(dx, dy);
  }

  function setupEpaperPreview() {
    const maybeRoot = document.querySelector<HTMLElement>(
      "[data-epaper-preview]",
    );
    if (!maybeRoot || maybeRoot.dataset.bound === "true") return;
    maybeRoot.dataset.bound = "true";
    const previewRoot: HTMLElement = maybeRoot;

    const fileInput =
      previewRoot.querySelector<HTMLInputElement>("[data-epaper-file]");
    const drop = previewRoot.querySelector<HTMLElement>("[data-epaper-drop]");
    const previewImage = previewRoot.querySelector<HTMLImageElement>(
      "[data-epaper-preview-image]",
    );
    const dropLabel = previewRoot.querySelector<HTMLElement>(
      "[data-epaper-drop-label]",
    );
    const uploadButton = previewRoot.querySelector<HTMLButtonElement>(
      "[data-epaper-upload]",
    );
    const controls = previewRoot.querySelector<HTMLElement>(
      "[data-epaper-controls]",
    );
    const status = previewRoot.querySelector<HTMLElement>(
      "[data-epaper-status]",
    );
    const sizeLabel =
      previewRoot.querySelector<HTMLElement>("[data-epaper-size]");
    const device = previewRoot.querySelector<HTMLElement>(
      ".epaper-preview__device",
    );
    const modeSelect =
      previewRoot.querySelector<HTMLSelectElement>("[data-epaper-mode]");
    const rotateImageButton = previewRoot.querySelector<HTMLButtonElement>(
      "[data-epaper-rotate-image]",
    );

    let currentFile: File | undefined;
    let rawImageSize: ImageSize | undefined;
    let rotation: SourceRotation = 0;
    let screenMount: ScreenMount = "landscape";
    let framing: FramingState = { centerX: 0, centerY: 0, zoom: 1 };
    let renderToken = 0;
    let loadToken = 0;
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;
    let pointerPanId: number | undefined;
    let lastPointerX = 0;
    let lastPointerY = 0;
    /** Screen distance moved while a pointer is down — skips upload-on-click. */
    let pointerPanDistance = 0;

    function framingImageSize(): ImageSize | undefined {
      if (!rawImageSize) return undefined;
      return rotatedImageSize(rawImageSize, rotation);
    }

    function syncPanButtons() {
      const imageSize = framingImageSize();
      const room = imageSize
        ? framingPanRoom(imageSize, framing, framingProfile)
        : { west: 0, east: 0, north: 0, south: 0 };
      // Arrows move the artwork; that consumes the opposite centre room.
      const enabled: Record<string, boolean> = {
        n: room.south > PAN_ROOM_EPS,
        s: room.north > PAN_ROOM_EPS,
        e: room.west > PAN_ROOM_EPS,
        w: room.east > PAN_ROOM_EPS,
        reset: Boolean(imageSize),
      };
      previewRoot
        .querySelectorAll<HTMLButtonElement>("[data-epaper-pan]")
        .forEach((button) => {
          const key = button.dataset.epaperPan ?? "";
          const on = enabled[key] ?? false;
          button.disabled = !on;
        });
    }

    function syncMountUi() {
      device?.classList.toggle("is-portrait", screenMount === "portrait");
      if (sizeLabel) sizeLabel.textContent = panelSizeLabel(screenMount);
      previewRoot
        .querySelectorAll<HTMLButtonElement>("[data-epaper-mount]")
        .forEach((button) => {
          const active = button.dataset.epaperMount === screenMount;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        });
      if (rotateImageButton) {
        rotateImageButton.textContent = `Rotate image (${rotation}°)`;
      }
      if (drop) {
        drop.setAttribute(
          "aria-label",
          currentFile
            ? "Preview artwork. Drag to move, scroll or pinch to zoom. Use Upload artwork to replace."
            : "Drop PNG or JPEG artwork, or press to upload",
        );
      }
      if (uploadButton) {
        uploadButton.textContent = currentFile
          ? "Replace artwork"
          : "Upload artwork";
      }
      syncPanButtons();
    }

    function clearPreviewUi() {
      if (previewImage) {
        previewImage.removeAttribute("src");
        previewImage.hidden = true;
      }
      if (dropLabel) dropLabel.hidden = false;
      if (controls) controls.hidden = true;
      drop?.classList.remove("has-preview");
      framing = { centerX: 0, centerY: 0, zoom: 1 };
      syncMountUi();
    }

    previewRoot
      .querySelectorAll<HTMLButtonElement>("[data-epaper-tab]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const tab = button.dataset.epaperTab;
          if (tab) activateTab(previewRoot, tab);
        });
      });

    function readMode(): MonoRenderMode {
      return (modeSelect?.value as MonoRenderMode | undefined) ?? "atkinson";
    }

    async function rerender() {
      if (!currentFile || !previewImage || !dropLabel || !rawImageSize) return;
      const token = ++renderToken;
      if (status) status.textContent = "Rendering…";
      try {
        const result = await renderUploadPreview(currentFile, {
          mode: readMode(),
          zoom: framing.zoom,
          centerX: framing.centerX,
          centerY: framing.centerY,
          rotation,
          screenMount,
        });
        if (token !== renderToken) return;
        previewImage.src = result.dataUrl;
        previewImage.hidden = false;
        dropLabel.hidden = true;
        controls && (controls.hidden = false);
        drop?.classList.add("has-preview");
        activateTab(previewRoot, "yours");
        if (status) {
          status.textContent = `Rendered ${result.width} × ${result.height} · simulation only`;
        }
      } catch (error) {
        if (token !== renderToken) return;
        if (status) {
          status.textContent =
            error instanceof Error
              ? error.message
              : "Could not render this image";
        }
      }
    }

    function scheduleRerender() {
      if (debounceTimer !== undefined) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        debounceTimer = undefined;
        void rerender();
      }, DEBOUNCE_MS);
    }

    function applyZoomAt(
      nextZoom: number,
      focalNormX: number,
      focalNormY: number,
    ) {
      const imageSize = framingImageSize();
      if (!imageSize) return;
      const before = sourceRectFromFraming(imageSize, framing, framingProfile);
      const focalX = before.x + before.width * focalNormX;
      const focalY = before.y + before.height * focalNormY;
      const zoom = clampZoom(nextZoom);
      const after = sourceRectFromFraming(
        imageSize,
        { ...framing, zoom },
        framingProfile,
      );
      framing = clampFraming(
        imageSize,
        {
          zoom,
          centerX: focalX - (focalNormX - 0.5) * after.width,
          centerY: focalY - (focalNormY - 0.5) * after.height,
        },
        framingProfile,
      );
      syncPanButtons();
      scheduleRerender();
    }

    async function loadFile(file: File | undefined) {
      if (!file) return;
      currentFile = file;
      const token = ++loadToken;
      renderToken += 1;
      rawImageSize = undefined;
      rotation = 0;
      if (debounceTimer !== undefined) {
        clearTimeout(debounceTimer);
        debounceTimer = undefined;
      }
      if (file.type !== "image/png" && file.type !== "image/jpeg") {
        currentFile = undefined;
        clearPreviewUi();
        if (status) status.textContent = "Only PNG and JPEG are supported";
        return;
      }
      syncMountUi();
      try {
        const size = await readImageSize(file);
        if (token !== loadToken || currentFile !== file) return;
        rawImageSize = size;
        framing = defaultFraming(rotatedImageSize(size, rotation));
        await rerender();
      } catch (error) {
        if (token !== loadToken || currentFile !== file) return;
        currentFile = undefined;
        clearPreviewUi();
        if (status) {
          status.textContent =
            error instanceof Error
              ? error.message
              : "Could not read this image";
        }
      }
    }

    function openFilePicker() {
      // Allow re-selecting the same file after a cancel / replace.
      if (fileInput) fileInput.value = "";
      fileInput?.click();
    }

    uploadButton?.addEventListener("click", () => openFilePicker());

    // Not a <label>: empty surface opens the picker; with artwork, only the
    // Upload button / file-drop replaces — pan gestures never open the picker.
    drop?.addEventListener("click", (event) => {
      if (event.target === fileInput) return;
      if (currentFile || pointerPanDistance > 6) {
        event.preventDefault();
        event.stopPropagation();
        pointerPanDistance = 0;
        return;
      }
      openFilePicker();
    });

    drop?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      if (currentFile) return;
      event.preventDefault();
      openFilePicker();
    });

    fileInput?.addEventListener("change", () => loadFile(fileInput.files?.[0]));

    drop?.addEventListener("dragover", (event) => {
      event.preventDefault();
    });
    drop?.addEventListener("drop", (event) => {
      event.preventDefault();
      loadFile(event.dataTransfer?.files?.[0]);
    });

    drop?.addEventListener(
      "wheel",
      (event) => {
        if (!rawImageSize || !currentFile) return;
        event.preventDefault();
        const rect = drop.getBoundingClientRect();
        const focalNormX =
          rect.width > 0 ? (event.clientX - rect.left) / rect.width : 0.5;
        const focalNormY =
          rect.height > 0 ? (event.clientY - rect.top) / rect.height : 0.5;
        const factor = event.deltaY < 0 ? 1.1 : 1 / 1.1;
        applyZoomAt(framing.zoom * factor, focalNormX, focalNormY);
      },
      { passive: false },
    );

    drop?.addEventListener("pointerdown", (event) => {
      if (!rawImageSize || !currentFile) return;
      if (event.pointerType === "mouse" && event.button !== 0) return;
      if (pointerPanId !== undefined) return;
      // Don't start a pan from the hidden file input.
      if (event.target === fileInput) return;
      pointerPanId = event.pointerId;
      lastPointerX = event.clientX;
      lastPointerY = event.clientY;
      pointerPanDistance = 0;
      drop.classList.add("is-panning");
      drop.setPointerCapture(event.pointerId);
    });

    drop?.addEventListener(
      "pointermove",
      (event) => {
        if (pointerPanId !== event.pointerId) return;
        if (!rawImageSize || !currentFile) return;
        if (pinchStartDistance > 0) return;
        const imageSize = framingImageSize();
        if (!imageSize) return;
        const display = drop.getBoundingClientRect();
        const clientDx = event.clientX - lastPointerX;
        const clientDy = event.clientY - lastPointerY;
        if (clientDx === 0 && clientDy === 0) return;
        lastPointerX = event.clientX;
        lastPointerY = event.clientY;
        pointerPanDistance += Math.hypot(clientDx, clientDy);
        framing = framingNudgeFromPointerDrag(
          imageSize,
          framing,
          framingProfile,
          clientDx,
          clientDy,
          display.width,
          display.height,
        );
        syncPanButtons();
        scheduleRerender();
      },
      { passive: true },
    );

    function endPointerPan(event: PointerEvent) {
      if (pointerPanId !== event.pointerId) return;
      pointerPanId = undefined;
      drop?.classList.remove("is-panning");
      try {
        drop?.releasePointerCapture(event.pointerId);
      } catch {
        // already released
      }
    }

    drop?.addEventListener("pointerup", endPointerPan);
    drop?.addEventListener("pointercancel", endPointerPan);

    drop?.addEventListener(
      "touchstart",
      (event) => {
        if (!rawImageSize || !currentFile) return;
        if (event.touches.length === 2) {
          pointerPanId = undefined;
          drop?.classList.remove("is-panning");
          pinchStartDistance = touchDistance(
            event.touches[0]!,
            event.touches[1]!,
          );
          pinchStartZoom = framing.zoom;
        }
      },
      { passive: true },
    );

    drop?.addEventListener(
      "touchmove",
      (event) => {
        if (!rawImageSize || !currentFile || event.touches.length !== 2) return;
        if (pinchStartDistance <= 0) return;
        event.preventDefault();
        const distance = touchDistance(event.touches[0]!, event.touches[1]!);
        applyZoomAt(pinchStartZoom * (distance / pinchStartDistance), 0.5, 0.5);
      },
      { passive: false },
    );

    drop?.addEventListener(
      "touchend",
      (event) => {
        if (event.touches.length < 2) {
          pinchStartDistance = 0;
        }
      },
      { passive: true },
    );

    modeSelect?.addEventListener("change", () => {
      void rerender();
    });

    rotateImageButton?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!rawImageSize) return;
      rotation = nextSourceRotation(rotation);
      framing = defaultFraming(rotatedImageSize(rawImageSize, rotation));
      syncMountUi();
      void rerender();
    });

    previewRoot
      .querySelectorAll<HTMLButtonElement>("[data-epaper-mount]")
      .forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          const mount = button.dataset.epaperMount;
          if (mount !== "landscape" && mount !== "portrait") return;
          screenMount = mount;
          syncMountUi();
          void rerender();
        });
      });

    previewRoot
      .querySelectorAll<HTMLButtonElement>("[data-epaper-pan]")
      .forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          const imageSize = framingImageSize();
          if (!imageSize) return;
          const direction = button.dataset.epaperPan;
          if (direction === "reset") {
            framing = defaultFraming(imageSize);
            syncPanButtons();
            void rerender();
            return;
          }
          if (
            direction !== "n" &&
            direction !== "s" &&
            direction !== "e" &&
            direction !== "w"
          ) {
            return;
          }
          framing = panFraming(
            imageSize,
            framing,
            framingProfile,
            direction as PanDirection,
            { step: PAN_STEP },
          );
          syncPanButtons();
          void rerender();
        });
      });

    syncMountUi();
  }

  setupEpaperPreview();
  document.addEventListener("astro:page-load", setupEpaperPreview);
</script>
