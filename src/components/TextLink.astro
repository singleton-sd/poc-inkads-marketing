---
interface Props {
  href: string;
  label: string;
  accent?: "brand" | "audience";
}

const { href, label, accent = "brand" } = Astro.props;
---

<a
  class:list={["text-link", accent === "audience" && "text-link--audience"]}
  href={href}
>
  <span>{label}</span>
  <span aria-hidden="true">→</span>
</a>
