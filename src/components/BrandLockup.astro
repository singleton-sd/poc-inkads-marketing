---
interface Props {
  href?: string;
  variant?: "header" | "footer" | "light";
  showByline?: boolean;
}

const {
  href = import.meta.env.BASE_URL,
  variant = "header",
  showByline = variant === "header",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const iconSrc =
  variant === "light"
    ? `${base}brand/icon-light.svg`
    : `${base}brand/icon-dark.svg`;
---

<a
  class:list={[
    "brand-lockup",
    variant === "footer" && "brand-lockup--footer",
    variant === "light" && "brand-lockup--light",
  ]}
  href={href}
  aria-label="InkAds home"
>
  <img
    class="brand-lockup__icon"
    src={iconSrc}
    alt=""
    width={variant === "footer" ? 40 : 32}
    height={variant === "footer" ? 40 : 32}
  />
  <span class="brand-lockup__text">
    <span class="brand-lockup__wordmark">InkAds</span>
    <span class="brand-lockup__underline" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
    {showByline && <span class="brand-lockup__byline">by Singleton SD</span>}
  </span>
</a>
