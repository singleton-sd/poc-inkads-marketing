---
interface Props {
  index: string;
  title: string;
  description: string;
  featured?: boolean;
  tag?: string;
}

const {
  index,
  title,
  description,
  featured = false,
  tag = "Initial focus",
} = Astro.props;
---

<article class:list={["place-card", { "place-card--featured": featured }]}>
  <div class="place-card__heading">
    <p class="eyebrow">{index}</p>
    {featured && <p class="place-card__tag">{tag}</p>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
