---
interface Props {
  title: string;
  tone?: "dark" | "brand" | "audience";
  titleId?: string;
}

const {
  title,
  tone = "dark",
  titleId = `cta-title-${crypto.randomUUID().slice(0, 8)}`,
} = Astro.props;
---

<section
  class:list={["cta-band", `cta-band--${tone}`]}
  aria-labelledby={titleId}
>
  <div class="shell">
    <h2 id={titleId}>{title}</h2>
    <div class="cta-band__actions">
      <slot />
    </div>
  </div>
</section>
